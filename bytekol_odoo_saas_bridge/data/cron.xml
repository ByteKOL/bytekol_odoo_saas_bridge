<odoo>
    <data noupdate="0">
        <record model="ir.cron" id="cron_clean_bk_token">
            <field name="name">BK token: clean</field>
            <field name="model_id" ref="model_bk_token"/>
            <field name="state">code</field>
            <field name="code">model._cron_clean_bk_token()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">3</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
        </record>

        <record model="ir.cron" id="cron_retry_queue_job">
            <field name="name">Simple Queue Job: Retry</field>
            <field name="model_id" ref="model_simple_queue_job"/>
            <field name="state">code</field>
            <field name="code">model._cron_retry_queue_jobs()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">2</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
        </record>
    </data>
</odoo>
