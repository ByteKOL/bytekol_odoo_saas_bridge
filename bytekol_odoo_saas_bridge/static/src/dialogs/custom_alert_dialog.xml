<templates>
    <t t-name="bytekol_odoo_saas_bridge.CustomAlertDialog">
        <Dialog size="'lg'" title="this.props.title" contentClass="this.props.contentClass">
            <p t-out="this.props.body" class="text-prewrap"/>
            <t t-set-slot="footer">
                <button class="btn" t-att-class="this.props.confirmClass" t-on-click="this._confirm" t-out="this.props.confirmLabel"/>
                <button t-if="this.props.cancel" class="btn btn-secondary" t-on-click="this._cancel" t-out="this.props.cancelLabel"/>
            </t>
        </Dialog>
    </t>
</templates>